{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geosource.dev/schemas/plugin.schema.json",
  "title": "AgentPlugin",
  "type": "object",
  "required": ["name", "version", "description", "skills"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "description"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
