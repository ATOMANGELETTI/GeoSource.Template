{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "GeoSource Template",
    "version":  "0.1.0",
    "identifier":  "com.geosource.template",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:3000",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "GeoSource Template",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  800,
                                    "minHeight":  600,
                                    "center":  true,
                                    "decorations":  false,
                                    "transparent":  false,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "shadow":  true,
                                    "visible":  false
                                },
                                {
                                    "label":  "splashscreen",
                                    "title":  "GeoSource Template Splashscreen",
                                    "url":  "/splashScreen",
                                    "width":  604,
                                    "height":  384,
                                    "center":  true,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "resizable":  false,
                                    "alwaysOnTop":  true,
                                    "shadow":  false,
                                    "visible":  true
                                },
                                {
                                    "label":  "tray-menu",
                                    "title":  "Tray Menu",
                                    "url":  "/tray-menu",
                                    "width":  220,
                                    "height":  230,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "resizable":  false,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "visible":  false,
                                    "shadow":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027 ipc:; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 asset: https://asset.localhost data:; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ipc: http://localhost:* ws://localhost:*"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "WebView2Loader.dll"
                                 ]
               }
}
