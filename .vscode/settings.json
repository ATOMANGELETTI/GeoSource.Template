{
  // Pinned editor tabs minimal icon-only styling
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.preventPinnedEditorClose": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.showIcons": true,

  // Rust Analyzer Configuration
  "rust-analyzer.linkedProjects": ["src-tauri/Cargo.toml"],
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.check.command": "clippy",

  // Formatting & Linting Defaults
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // File Exclusions & Watcher Optimization
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/src-tauri/target": true,

    // .gitkeep Files Excluded
    "**/other/logs/.gitkeep": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/src-tauri/target/**": true,

    // .gitkeep Files Excluded
    "**/other/logs/.gitkeep": true
  },

  // Search Exclusions
  "search.exclude": {
    "**/node_modules": true,
    "**/src-tauri/target": true,
    "**/dist": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,

    // .gitkeep Files Excluded
    "**/other/logs/.gitkeep": true
  }
}
