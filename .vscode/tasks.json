{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tauri: dev",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "tauri",
        "dev"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "tauri: build",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "tauri",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "cargo: check",
      "type": "shell",
      "command": "cargo",
      "args": [
        "check",
        "--manifest-path",
        "${workspaceFolder}/src-tauri/Cargo.toml"
      ],
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "cargo: build",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--manifest-path",
        "${workspaceFolder}/src-tauri/Cargo.toml"
      ],
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
