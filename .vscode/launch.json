{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust: Debug Tauri Core (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/src-tauri/target/debug/geosource-template.exe",
      "args": [],
      "cwd": "${workspaceFolder}/src-tauri",
      "preLaunchTask": "cargo: build"
    },
    {
      "name": "Frontend: Debug Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "frontend: dev"
    },
    {
      "name": "Frontend: Debug Web (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "frontend: dev"
    }
  ],
  "compounds": [
    {
      "name": "Tauri: Fullstack Debug (CodeLLDB + Chrome)",
      "configurations": ["Rust: Debug Tauri Core (CodeLLDB)", "Frontend: Debug Web (Chrome)"],
      "stopAll": true
    }
  ]
}
